{
  "name": "whatsapp-service-standalone",
  "version": "1.0.0",
  "description": "Standalone WhatsApp service without LLM integration",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "start:backend": "node integrations/example-backend.js",
    "start:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "stop:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1",
    "start:cloud": "node index-cloud.js",
    "dev": "node --watch index.js",
    "reset-session": "node ./scripts/clear-wwebjs-session.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "github:timothydillan/whatsapp-web.js#fix/duplicate-events-and-bindings"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
